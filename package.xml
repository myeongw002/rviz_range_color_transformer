<?xml version="1.0"?>
<package format="3">
  <name>rviz_range_color_transformer</name>
  <version>0.1.0</version>
  <description>RViz2 PointCloud2 color transformer that colors points by Euclidean range without modifying the cloud.</description>

  <maintainer email="117157396+myeongw002@users.noreply.github.com">myeongw002</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>
  <depend>rviz_rendering</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
